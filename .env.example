# Tofu provides these values when the managed database is connected.
# Never commit a populated .env file or log these settings.
DATABASE_URL=
# Optional PEM CA bundle for a nonstandard database provider. Never disable TLS verification.
# Standard Supabase database hosts use the bundled official public CA.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
